    "Export the whole vault as a single passphrase-protected .fwvault file (Save to Files), or restore one. Same format as the FileWall Android app.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta toda la bóveda como un único archivo .fwvault protegido con frase de contraseña (Guardar en Archivos), o restaura uno. Mismo formato que la app FileWall de Android."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پورے والٹ کو ایک پاس فریز سے محفوظ .fwvault فائل کے طور پر ایکسپورٹ کریں (فائلز میں محفوظ کریں)، یا ایک بحال کریں۔ FileWall کی Android ایپ جیسا فارمیٹ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کل گاوصندوق را به‌صورت یک فایل .fwvault محافظت‌شده با عبارت عبور صادر کنید (ذخیره در فایل‌ها)، یا یکی را بازیابی کنید. همان قالب برنامه Android فایل‌وال."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صدّر الخزنة كاملة كملف .fwvault واحد محمي بعبارة مرور (حفظ في الملفات)، أو استعد ملفًا. بالصيغة نفسها لتطبيق FileWall على Android."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将整个保险库导出为单个受口令保护的 .fwvault 文件（存储到“文件”），或恢复一个。与 FileWall Android 应用格式相同。"
          }
        }
      }
    },
