    "Authentication failed. Try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autenticación falló. Inténtalo de nuevo."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدیق ناکام ہوئی۔ دوبارہ کوشش کریں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "احراز هویت ناموفق بود. دوباره امتحان کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت المصادقة. حاول مرة أخرى."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证失败，请重试。"
          }
