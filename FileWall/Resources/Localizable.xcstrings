    "The folder is removed. Its files aren’t deleted — they move back to the main vault.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta se elimina. Sus archivos no se borran: vuelven a la bóveda principal."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فولڈر ہٹا دیا جائے گا۔ اس کی فائلیں حذف نہیں ہوں گی — وہ واپس اصل والٹ میں چلی جائیں گی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پوشه حذف می‌شود. فایل‌های آن پاک نمی‌شوند — به گاوصندوق اصلی برمی‌گردند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم إزالة المجلد. لا تُحذف ملفاته — بل تعود إلى الخزنة الرئيسية."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件夹将被移除。其中的文件不会被删除，而是移回主保险库。"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تھیم"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمینه"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السمة"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题"
          }
        }
      }
    },
    "This can’t be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ واپس نہیں ہو سکتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار قابل بازگشت نیست."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن هذا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。"
          }
        }
      }
    },
    "This is an AI and can make mistakes. The model used here is Gemini by Google Inc.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es una IA y puede cometer errores. El modelo usado aquí es Gemini de Google Inc."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ایک AI ہے اور غلطیاں کر سکتا ہے۔ یہاں استعمال ہونے والا ماڈل Google Inc. کا Gemini ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این یک هوش مصنوعی است و ممکن است اشتباه کند. مدل استفاده‌شده Gemini از Google Inc. است."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ذكاء اصطناعي وقد يرتكب أخطاء. النموذج المستخدم هنا هو Gemini من Google Inc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 AI，可能会出错。此处使用的模型是 Google Inc. 的 Gemini。"
          }
        }
      }
    },
