    "Empty Recently Deleted?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Vaciar Eliminados recientemente?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حال ہی میں حذف شدہ خالی کریں؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اخیراً حذف‌شده‌ها خالی شود؟"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إفراغ المحذوفة مؤخرًا؟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空“最近删除”？"
          }
        }
      }
    },
    "Encrypted Archive": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo cifrado"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خفیہ آرکائیو"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بایگانی رمزگذاری‌شده"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأرشيف المشفّر"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密归档"
          }
        }
      }
    },
    "Encrypted before it leaves your device and shares one backup with the FileWall Android app. As safe as your Google account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cifra antes de salir de tu dispositivo y comparte una copia de seguridad con la app FileWall de Android. Tan segura como tu cuenta de Google."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے آلے سے نکلنے سے پہلے خفیہ کیا جاتا ہے اور FileWall کی Android ایپ کے ساتھ ایک بیک اپ شیئر کرتا ہے۔ آپ کے Google اکاؤنٹ جتنا محفوظ۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از خروج از دستگاه شما رمزگذاری می‌شود و یک نسخه پشتیبان با برنامه Android فایل‌وال به اشتراک می‌گذارد. به اندازه حساب Google شما امن."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُشفَّر قبل أن تغادر جهازك وتشارك نسخة احتياطية واحدة مع تطبيق FileWall على Android. آمنة بقدر حساب Google الخاص بك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在离开您的设备前即已加密，并与 FileWall Android 应用共享同一份备份。与您的 Google 账户一样安全。"
          }
        }
      }
    },
    "Enter the passphrase this .fwvault was exported with.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la frase de contraseña con la que se exportó este .fwvault."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ پاس فریز درج کریں جس کے ساتھ یہ .fwvault ایکسپورٹ ہوئی تھی۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارت عبوری را وارد کنید که این .fwvault با آن صادر شده است."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل عبارة المرور التي صُدِّر بها ملف .fwvault هذا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入导出此 .fwvault 时使用的口令。"
          }
        }
      }
    },
