    "Locks the hidden vault after this idle time. The vault also always locks when the app goes to the background.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea la bóveda oculta tras este tiempo de inactividad. La bóveda también se bloquea siempre que la app pasa a segundo plano."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس غیر فعالی کے وقت کے بعد چھپا ہوا والٹ لاک ہو جاتا ہے۔ ایپ پس منظر میں جائے تو والٹ ہمیشہ لاک ہو جاتا ہے۔"
          }
        }
      }
    },
