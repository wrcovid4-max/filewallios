          }
        }
      }
    },
    "Lock after": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear después de"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے بعد لاک کریں"
          }
        },
