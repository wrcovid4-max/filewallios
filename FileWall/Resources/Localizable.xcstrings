    "Show the Vault / Hidden / Security switcher in a left sidebar (with your folders under it) or as a centered bar across the top.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el selector Bóveda / Oculto / Seguridad en una barra lateral izquierda (con tus carpetas debajo) o como una barra centrada en la parte superior."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ / چھپی / سیکیورٹی کا انتخاب بائیں سائڈ بار میں (آپ کے فولڈرز اس کے نیچے) یا اوپر مرکز میں ایک پٹی کے طور پر دکھائیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایش انتخاب‌گر گاوصندوق / پنهان / امنیت در نوار کناری چپ (با پوشه‌هایتان زیر آن) یا به‌صورت نوار وسط‌چین در بالا."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أظهر مبدّل الخزنة / المخفي / الأمان في شريط جانبي أيسر (مع مجلداتك أسفله) أو كشريط في المنتصف أعلى الشاشة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将“保险库 / 隐藏 / 安全”切换栏显示在左侧边栏（文件夹位于其下）或顶部居中的横栏中。"
          }
        }
      }
    },
